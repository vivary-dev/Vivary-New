{
  "extends": "@agent-native/core/tsconfig.base.json",
  "compilerOptions": {
    "rootDirs": [
      ".",
      "./.react-router/types"
    ],
    "paths": {
      "@/*": [
        "./app/*"
      ]
    },
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2024"
    ]
  },
  "include": [
    "app/**/*",
    "vite.config.ts",
    "react-router.config.ts",
    ".react-router/types/**/*",
    ".generated/**/*"
  ]
}
