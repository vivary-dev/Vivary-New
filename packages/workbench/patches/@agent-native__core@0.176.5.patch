index 0000000000000000000000000000000000000000..b17699cccc0bba6f27eb3b8953d9ef7b20453662
--- /dev/null
+++ b/dist/cli/codex-app-server-executor.js
@@ -0,0 +1,468 @@
+import { spawn } from "node:child_process";
+import { randomUUID } from "node:crypto";
+import path from "node:path";
+
+const REQUEST_TIMEOUT_MS = 15_000;
+const INTERRUPT_TIMEOUT_MS = 3_000;
+const MAX_LINE_BYTES = 8 * 1024 * 1024;
+const MAX_TRACKED_THREADS = 128;
+const MAX_CACHED_ITEMS = 256;
+const MAX_CACHED_ITEM_CHARS = 2 * 1024 * 1024;
+const SUPPORTED_REQUESTS = new Set([
+    "item/commandExecution/requestApproval", "item/fileChange/requestApproval",
+    "item/permissions/requestApproval", "mcpServer/elicitation/request", "item/tool/requestUserInput",
+]);
+
+function isRecord(value) {
+    return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+function permissionSettings(mode, cwd) {
+    switch (mode) {
+        case "normal": return { approvalPolicy: "on-request", sandbox: "workspace-write",
+            sandboxPolicy: { type: "workspaceWrite", writableRoots: [cwd], networkAccess: false } };
+        case "read-only": return { approvalPolicy: "never", sandbox: "read-only",
+            sandboxPolicy: { type: "readOnly", networkAccess: false } };
+        case "yolo": return { approvalPolicy: "never", sandbox: "danger-full-access",
+            sandboxPolicy: { type: "dangerFullAccess" } };
+        default: throw new Error("Choose Normal, Read only, or YOLO for Codex.");
+    }
+}
+function samePath(left, right) {
+    const normalize = value => process.platform === "win32" ? path.resolve(value).toLowerCase() : path.resolve(value);
+    return normalize(left) === normalize(right);
+}
+function validateThread(result, options, policy) {
+    if (!isRecord(result) || !isRecord(result.thread) || typeof result.thread.id !== "string"
+        || result.modelProvider !== "openai" || typeof result.cwd !== "string"
+        || !samePath(result.cwd, options.cwd) || (options.model && result.model !== options.model)
+        || result.approvalPolicy !== policy.approvalPolicy || result.approvalsReviewer !== "user"
+        || !isRecord(result.sandbox) || result.sandbox.type !== policy.sandboxPolicy.type) {
+        throw new Error("Codex did not apply the selected project, model, or permissions. No turn was started.");
+    }
+    if (options.threadId && result.thread.id !== options.threadId) {
+        throw new Error("Codex resumed a different conversation. No turn was started.");
+    }
+    if (policy.sandbox !== "danger-full-access") {
+        const roots = result.sandbox.writableRoots ?? [];
+        if (result.sandbox.networkAccess === true || !Array.isArray(roots)
+            || roots.some(root => typeof root !== "string" || !samePath(root, options.cwd))) {
+            throw new Error("Codex returned permissions outside the selected project. No turn was started.");
+        }
+    }
+    return result.thread.id;
+}
+
+/** Run one native Codex turn. The host owns process-tree cleanup and request authorization. */
+export async function runCodexAppServer(options) {
+    const policy = permissionSettings(options.permissionMode, options.cwd);
+    if (options.signal?.aborted) return { status: "interrupted" };
+    const child = spawn(options.command, [...(options.argsPrefix ?? []), "app-server", "--listen", "stdio://"], {
+        cwd: options.cwd, env: options.env ?? process.env, shell: false, windowsHide: true,
+        stdio: ["pipe", "pipe", "pipe"],
+    });
+    let closed = false;
+    let stopping = false;
+    let completed = false;
+    let buffer = "";
+    let stderr = "";
+    let sequence = 0;
+    let threadId;
+    let effectiveModel;
+    let reportedThread = false;
+    let turnId;
+    let startingTurn = false;
+    let interruptTimer;
+    const pendingCalls = new Map();
+    const pendingRequests = new Map();
+    const items = new Map();
+    let itemChars = 0;
+    let rootOutcome;
+    const members = new Set();
+    const checkingThreads = new Map();
+    const threadStates = new Map();
+    const collabItems = new Map();
+    const activityItems = new Map();
+    const summaryReads = new Map();
+    const itemKey = params => JSON.stringify([params.threadId, params.turnId, params.itemId ?? params.item?.id]);
+    function rememberItem(params, item) {
+        const key = itemKey(params);
+        const previous = items.get(key);
+        if (previous) { itemChars -= previous.size; items.delete(key); }
+        const size = JSON.stringify(item).length;
+        if (size > MAX_CACHED_ITEM_CHARS) return;
+        items.set(key, { item, size });
+        itemChars += size;
+        while (items.size > MAX_CACHED_ITEMS || itemChars > MAX_CACHED_ITEM_CHARS) {
+            const oldest = items.keys().next().value;
+            itemChars -= items.get(oldest).size;
+            items.delete(oldest);
+            collabItems.delete(oldest);
+        }
+    }
+    function stateFor(id) {
+        if (!threadStates.has(id)) {
+            if (threadStates.size >= MAX_TRACKED_THREADS) throw new Error("Codex exceeded the supported number of active agent threads.");
+            threadStates.set(id, { active: false });
+        }
+        return threadStates.get(id);
+    }
+    function finishWhenReady() {
+        if (!rootOutcome || completed) return;
+        if (rootOutcome.status === "completed" && (checkingThreads.size || pendingRequests.size || summaryReads.size
+            || [...members].some(id => id !== threadId && threadStates.get(id)?.active))) return;
+        finish(rootOutcome);
+    }
+    function publishCollab(entry) {
+        const agentsStates = { ...entry.params.item.agentsStates };
+        for (const id of entry.params.item.receiverThreadIds ?? []) {
+            const state = threadStates.get(id);
+            if (state?.status) agentsStates[id] = { status: state.status, ...(state.message ? { message: state.message } : {}) };
+        }
+        options.onNotification?.(entry.method, { ...entry.params, item: { ...entry.params.item, agentsStates } });
+    }
+    function publishActivity(entry) {
+        const state = threadStates.get(entry.params.item.agentThreadId);
+        options.onNotification?.(entry.method, { ...entry.params,
+            agentState: { status: state?.status ?? "running", ...(state?.message ? { message: state.message } : {}) } });
+    }
+    function refreshAgentCards(id) {
+        const activity = activityItems.get(id);
+        if (activity) publishActivity(activity);
