+/**
+ * Whether Core offers Builder.io: its credits, its connect buttons, and the
+ * model guidance that points to it. A host turns the offers off when it wants
+ * owners to use their own provider keys only, as the Vivary desktop app does.
+ * Core's own behavior, with offers on, is the default.
+ *
+ * The server keeps the value on globalThis, because Core can load twice in one
+ * process. The browser reads the value the server put in the page config, so
+ * both sides agree without a request. Read it when an offer would render or a
+ * prompt is built, never at module load, because the host sets it after Core
+ * loads.
+ */
+const BUILDER_OFFERS_KEY = "__agentNativeBuilderOffers";
+export function setBuilderOffersEnabled(enabled) {
+    globalThis[BUILDER_OFFERS_KEY] = enabled !== false;
+}
+export function builderOffersEnabled() {
+    if (typeof window !== "undefined") {
+        return window.__AGENT_NATIVE_CONFIG__?.builderOffers !== false;
+    }
+    return globalThis[BUILDER_OFFERS_KEY] !== false;
+}
