+export declare const UNATTENDED_PROMPT_NOTE: string;
+export declare function isConfigurationResourcePath(value: unknown): boolean;
+/** True for an argument name the CLI bridge would split or read as a flag. */
+export declare function isUnsafeArgumentName(name: string): boolean;
+/**
+ * Returns the error text for a tool call that an automation run may not
+ * make, or null when the call is allowed.
+ */
+export declare function unattendedToolRefusal(toolName: string, args: Record<string, unknown> | undefined): string | null;
+/** The arguments a kept tool runs with in an automation run. */
+export declare function unattendedToolArgs<T extends Record<string, unknown> | undefined>(toolName: string, args: T): T;
+/** A run that must not start. `errorCode` goes to the run history row. */
+export declare class UnattendedRunRefusedError extends Error {
+    errorCode: string;
+    constructor(message: string, errorCode: string);
+}
+/**
+ * Keep only the allowlisted tools and route each call through the refusal
+ * check. Throws `UnattendedRunRefusedError` when the automation lists MCP tools.
+ */
+export declare function restrictActionsForUnattendedRun(actions: Record<string, ActionEntry>, automation?: Pick<BackgroundAutomationContext, "meta">): Record<string, ActionEntry>;
