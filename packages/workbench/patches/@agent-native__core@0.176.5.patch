+ *
+ * The background runner appends ". No delivery was confirmed." to the
+ * message, so it ends without a period.
+ */
+export function restrictActionsForUnattendedRun(actions, automation) {
+    const mcpTools = automation?.meta?.mcpTools ?? [];
+    if (mcpTools.length > 0) {
+        throw new UnattendedRunRefusedError(`This automation lists MCP tools (${mcpTools.join(", ")}). Automation runs cannot call MCP tools. Nothing ran`, "automation_mcp_tools_refused");
+    }
+    const restricted = {};
+    for (const name of UNATTENDED_TOOLS) {
+        const entry = actions[name];
+        if (!entry)
+            continue;
+        restricted[name] = {
+            ...entry,
+            run: async (args, context) => {
+                // Only the arguments the tool declares reach it.
+                const declared = entry.tool?.parameters?.properties ?? {};
+                const undeclared = Object.keys(args ?? {}).find((key) => !Object.hasOwn(declared, key));
+                if (undeclared !== undefined) {
+                    return `Error: automation runs cannot pass ${JSON.stringify(undeclared.slice(0, 80))}, which ${name} does not declare.`;
+                }
+                const refusal = unattendedToolRefusal(name, args);
+                if (refusal)
+                    return refusal;
+                return entry.run(unattendedToolArgs(name, args), {
+                    ...context,
+                    caller: "automation",
+                });
+            },
+        };
+    }
+    return restricted;
+}
