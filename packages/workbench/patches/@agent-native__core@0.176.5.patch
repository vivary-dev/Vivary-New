+    }
+    const action = args?.action;
+    const permitted = PERMITTED_ACTIONS[toolName];
+    if (permitted && !permitted.actions.has(action)) {
+        return permitted.refusal;
+    }
+    if (toolName === "resources" &&
+        CONFIGURATION_ACTIONS.has(action) &&
+        isConfigurationResourcePath(args?.path)) {
+        return `Error: automation runs cannot ${action} ${String(args.path)}. That path configures automations, agents, or connections.`;
+    }
+    // The memory scripts build memory/<name>.md from the name as given.
+    if (MEMORY_TOOLS.has(toolName)) {
+        const name = typeof args?.name === "string" ? args.name : "";
+        if (/[\\/]|\.\./.test(name) ||
+            isConfigurationResourcePath(`memory/${name}.md`)) {
+            return `Error: automation runs cannot use the memory name ${JSON.stringify(name.slice(0, 80))}.`;
+        }
+    }
+    if (toolName === "chat-history" && action === "open") {
+        return "Error: automation runs cannot open a chat in the app.";
+    }
+    return null;
+}
+/**
+ * The arguments a kept tool runs with in an automation run. A notification
+ * goes to the in-app inbox only, never to a webhook, Slack, or email channel.
+ */
+export function unattendedToolArgs(toolName, args) {
+    if (toolName === "manage-notifications" && args?.action === "send") {
+        return { ...args, channels: "inbox" };
+    }
+    return args;
+}
+/** A run that must not start. `errorCode` goes to the run history row. */
+export class UnattendedRunRefusedError extends Error {
+    errorCode;
+    constructor(message, errorCode) {
+        super(message);
+        this.name = "UnattendedRunRefusedError";
+        this.errorCode = errorCode;
+    }
+}
+/**
+ * Keep only the allowlisted tools and route each call through the refusal
+ * check. An automation that lists MCP tools fails here, before any model call:
+ * an approval cannot be granted after the fact in an unattended run, so its
