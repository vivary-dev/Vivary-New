--- /dev/null
+++ b/dist/shared/automation-webhook-reach.js
@@ -0,0 +1,21 @@
+/**
+ * Who can reach this app's automation webhook URLs, as the host knows it:
+ * "local" (the loopback address of this computer), "owner-proxy" (a private
+ * proxy that admits only the owner), or "public". The page origin cannot tell
+ * these apart, so the host sets it. Unset, the Automations page falls back to
+ * reading the origin.
+ *
+ * Like the Builder offers switch, the server keeps the value on globalThis and
+ * the browser reads it from the page config.
+ */
+const REACH_KEY = "__agentNativeAutomationWebhookReach";
+const REACHES = new Set(["local", "owner-proxy", "public"]);
+export function setAutomationWebhookReach(reach) {
+    globalThis[REACH_KEY] = REACHES.has(reach) ? reach : undefined;
+}
+export function automationWebhookReach() {
+    const reach = typeof window !== "undefined"
+        ? window.__AGENT_NATIVE_CONFIG__?.automationWebhookReach
+        : globalThis[REACH_KEY];
+    return REACHES.has(reach) ? reach : null;
+}
