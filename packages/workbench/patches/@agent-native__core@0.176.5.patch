+// Vivary #97: the host registers one text redactor. Core calls redactText before
+// a tool result, a run event, an error message, a saved thread, an automation
+// error, or a Code transcript event is kept, shown, stored, or sent to a model.
+// With no redactor registered, text passes through unchanged. A redactor that
+// fails withholds the text rather than letting it through.
+const TEXT_REDACTION_FAILED = "[text withheld because redaction failed]";
+let registeredTextRedactor = null;
+export function setTextRedactor(redactor) {
+    registeredTextRedactor = typeof redactor === "function" ? redactor : null;
+}
+export function redactText(text) {
+    if (typeof text !== "string" || text.length === 0 || !registeredTextRedactor)
+        return text;
+    try {
+        const redacted = registeredTextRedactor(text);
+        return typeof redacted === "string" ? redacted : TEXT_REDACTION_FAILED;
+    }
+    catch {
+        return TEXT_REDACTION_FAILED;
+    }
+}
+/**
+ * Redact every string in a plain object or array. The same value comes back
+ * when nothing changed, so an unchanged event keeps its identity.
+ */
+export function redactTextInValue(value) {
+    return registeredTextRedactor ? redactTextWalk(value, 0) : value;
+}
+function redactTextWalk(value, depth) {
+    if (typeof value === "string")
+        return redactText(value);
+    if (!value || typeof value !== "object" || depth > 32)
