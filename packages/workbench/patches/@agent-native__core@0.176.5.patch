+/**
+ * Local-only tool surface for unattended automation runs.
+ *
+ * Scheduled, event, webhook, and Run now runs have nobody present to approve
+ * a step. They keep to tools that act on this server's own data: they cannot
+ * send messages, reach the network or other agents, call MCP tools, or change
+ * settings, jobs, or automations. This is an allowlist, so a tool that a later
+ * Core release adds stays out of automation runs until someone reviews it.
+ *
+ * The background runner applies `restrictActionsForUnattendedRun`. The kept
+ * tools also call `unattendedToolRefusal` themselves when their caller is
+ * "automation", so a tool reached some other way enforces the same limits.
+ */
+import path from "node:path";
+/** The only tools an automation run is offered. */
+export const UNATTENDED_TOOLS = Object.freeze([
+    "resources",
+    "save-memory",
+    "delete-memory",
+    "chat-history",
+    "manage-progress",
+    "manage-notifications",
+    "manage-jobs",
+    "manage-automations",
+    "docs-search",
+    "framework-search",
+    "source-search",
+    "get-framework-context",
+]);
+/** Appended to the framework prompt of an automation run in place of the action list. */
+export const UNATTENDED_PROMPT_NOTE = "\n\nThis is an unattended automation run. It is local-only and has only the tools attached to this request.\n" +
+    "It cannot send email or messages, reach the web or other agents, use MCP tools, or change settings, jobs, or automations. Do not promise those steps.\n";
+/** Tools that an automation run may call for some actions only. */
+const PERMITTED_ACTIONS = {
+    "manage-jobs": {
+        actions: new Set(["list"]),
+        refusal: "Error: automation runs can only list recurring jobs. They cannot create, update, or delete them.",
+    },
+    "manage-automations": {
+        actions: new Set(["list", "list-events", "list-hosts"]),
+        refusal: "Error: automation runs can only list automations, events, and hosts. They cannot define, update, delete, test, or run automations.",
+    },
+};
+// Reads count too: these files can hold server headers or tokens that a run
+// could copy into memory.
+const CONFIGURATION_ACTIONS = new Set([
+    "read",
+    "effective",
+    "write",
+    "promote",
+    "delete",
+]);
+const MEMORY_TOOLS = new Set(["save-memory", "delete-memory"]);
+/**
+ * Resource paths that Core reads as configuration. The scheduler and the
+ * trigger dispatcher load automations from jobs/. Custom agent profiles under
+ * agents/ set a model and tools. Remote agent manifests under remote-agents/
+ * (and legacy agents/*.json) hold the URLs that call-agent reaches. In local
+ * file mode the workspace control files agent-native.json, mcp.config.json,
+ * and .mcp.json set the data mode and the MCP servers.
+ */
+const CONFIGURATION_PATH_PREFIXES = ["jobs/", "agents/", "remote-agents/"];
+const CONFIGURATION_FILES = new Set([
+    "agent-native.json",
+    "mcp.config.json",
+    ".mcp.json",
+]);
