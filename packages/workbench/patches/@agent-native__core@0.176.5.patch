+/**
+ * The CLI bridge behind resources, save-memory, delete-memory, chat-history,
+ * and the lookups turns each argument into a `--name` flag, and its parser
+ * reads `--name=value` and lets a later flag win. An argument named
+ * "path=jobs/x.md" would replace a path that the checks below accepted, so
+ * an automation run may not pass a name that holds "=" or starts with "-".
+ */
+export function isUnsafeArgumentName(name) {
+    return name.includes("=") || name.startsWith("-");
