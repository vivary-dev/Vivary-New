+export function isConfigurationResourcePath(value) {
+    const normalized = normalizeResourcePath(value);
+    return (CONFIGURATION_FILES.has(normalized) ||
+        CONFIGURATION_PATH_PREFIXES.some((prefix) => normalized.startsWith(prefix)));
